### Health check do banco
GET {{baseUrl}}/health/db

### Registro de usuário
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "teste@exemplo.com",
  "name": "Usuário Teste",
  "password": "123456",
  "passwordConfirm": "123456"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "teste@exemplo.com",
  "password": "123456"
}

### Meu usuário autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{authToken}}

### Listar produtos
GET {{baseUrl}}/produtos

### Buscar produto por ID
GET {{baseUrl}}/produtos/1

### Criar produto
POST {{baseUrl}}/produtos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "nome": "Camiseta Básica",
  "categoria": "Camisetas",
  "cor": "Preto",
  "tamanho": "M",
  "preco_custo": 25.5,
  "preco_venda": 49.9,
  "preco_unitario": 49.9,
  "estoque_minimo": 10,
  "ativo": 1
}

### Atualizar produto
PUT {{baseUrl}}/produtos/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "nome": "Camiseta Básica Premium",
  "categoria": "Camisetas",
  "cor": "Preto",
  "tamanho": "M",
  "preco_custo": 28,
  "preco_venda": 54.9,
  "estoque_minimo": 8,
  "ativo": 1
}

### Remover produto
DELETE {{baseUrl}}/produtos/1
Authorization: Bearer {{authToken}}

### Listar clientes
GET {{baseUrl}}/clientes

### Buscar cliente por ID
GET {{baseUrl}}/clientes/1

### Criar cliente
POST {{baseUrl}}/clientes
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "nome": "João Silva",
  "cpf": "123.456.789-00",
  "telefone": "(11) 98765-4321",
  "email": "joao.silva@exemplo.com",
  "endereco": "Rua Teste, 123"
}

### Atualizar cliente
PUT {{baseUrl}}/clientes/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "nome": "João Silva Atualizado",
  "cpf": "123.456.789-00",
  "telefone": "(11) 98888-7777",
  "email": "joao.silva@exemplo.com",
  "endereco": "Rua Atualizada, 456"
}

### Inativar cliente
DELETE {{baseUrl}}/clientes/1
Authorization: Bearer {{authToken}}